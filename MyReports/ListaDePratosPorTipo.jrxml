	<parameter name="tipo_prato" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    p.idPrato,
    p.nome,
    p.porcao,
    p.valor,
    t.nome_tipo AS tipo,
    ISNULL(STRING_AGG(i.nome, ', '), 'Nenhum ingrediente cadastrado') AS ingredientes
FROM Prato p
INNER JOIN tb_tipo_prato t ON p.id_tipo = t.id_tipo 
LEFT JOIN PratoIngrediente pi ON p.idPrato = pi.idPrato
LEFT JOIN Ingrediente i ON pi.idIngrediente = i.idIngrediente
WHERE t.nome_tipo = $P{tipo_prato}
GROUP BY p.idPrato, p.nome, p.porcao, p.valor, t.nome_tipo]]>
	</queryString>
