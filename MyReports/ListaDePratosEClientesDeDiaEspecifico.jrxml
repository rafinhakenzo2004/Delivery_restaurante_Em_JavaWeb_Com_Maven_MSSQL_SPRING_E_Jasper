	<parameter name="data" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    pe.idPedido,
    pe.dataRealizacao,
    pe.valorTotal AS total_pedido,
    c.nome AS nome_cliente,
    c.cpf AS cpf_cliente,
    p.nome AS nome_prato,
    p.porcao AS porcao_prato,
    p.valor AS valor_unitario,
    pp.quantidade,
    (pp.quantidade * p.valor) AS subtotal,
    ing.lista_ingredientes
FROM Pedido pe
INNER JOIN Cliente c ON pe.ClienteCpf = c.cpf
INNER JOIN PratoPedido pp ON pe.idPedido = pp.idPedido
INNER JOIN Prato p ON pp.idPrato = p.idPrato
LEFT JOIN (
    SELECT pi.idPrato, STRING_AGG(i.nome, ', ') AS lista_ingredientes
    FROM PratoIngrediente pi
    INNER JOIN Ingrediente i ON pi.idIngrediente = i.idIngrediente
    GROUP BY pi.idPrato
) ing ON p.idPrato = ing.idPrato
WHERE pe.dataRealizacao = $P{data}]]>
	</queryString>
